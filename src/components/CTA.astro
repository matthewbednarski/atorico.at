---
interface Props {
  title: string;
  text: string;
  href: string;
  label: string;
}
const { title, text, href, label } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta">
      <h2>{title}</h2>
      <p class="lead">{text}</p>
      <div class="actions">
        <a class="button" href={href}>{label}</a>
      </div>
    </div>
  </div>
</section>
