---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact Atorico for platform consulting or an EarlyBird demo.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Start with the problem you want to solve.</h1>
      <p class="lead">For consulting, platform work, or an EarlyBird demo, send a short description of the workflow, system, or spreadsheet that causes friction.</p>
      <div class="grid-2" style="margin-top: 32px;">
        <article class="card">
          <h3>Email</h3>
          <p><a href="mailto:info@atorico.at">info@atorico.at</a></p>
        </article>
        <article class="card">
          <h3>EarlyBird demo</h3>
          <p>Bring a real spreadsheet use case. A short walkthrough is enough to see whether EarlyBird fits your workflow.</p>
          <p><a class="button" href="https://calendly.com/atorico/earlybird-demo">Book a demo</a></p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
