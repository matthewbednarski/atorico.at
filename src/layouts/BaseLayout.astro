---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Atorico helps teams build secure platforms, reliable delivery processes, and spreadsheet validation workflows.' } = Astro.props;
const pageTitle = title === 'Atorico' ? title : `${title} · Atorico`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="Atorico home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Atorico</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/earlybird/">EarlyBird</a>
          <a href="/services/">Services</a>
          <a href="/posts/">Posts</a>
          <a href="/contact/" class="button">Contact</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-row">
        <span>© {new Date().getFullYear()} Atorico</span>
        <span><a href="/privacy-policy/">Privacy Policy</a></span>
      </div>
    </footer>
  </body>
</html>
